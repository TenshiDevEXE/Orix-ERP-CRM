# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_dev?schema=public"

# Cloud (cuando se configure)
CLOUD_DATABASE_URL="postgresql://user:password@cloud-host:5432/erp_prod?schema=public"

# JWT Secret (para cloud)
JWT_SECRET="your-secret-key-change-in-production"
JWT_EXPIRATION="7d"

# Application
NODE_ENV="development"
PORT=3000

# Sync
SYNC_RETRY_INTERVAL=60000
SYNC_MAX_ATTEMPTS=5
