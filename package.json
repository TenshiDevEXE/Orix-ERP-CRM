{
  "name": "erp-hibrido-rd",
  "version": "0.1.0",
  "description": "ERP Híbrido Multi-empresa para República Dominicana",
  "private": true,
  "workspaces": [
    "apps/*",
    "shared-core"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "jest --config tests/jest.config.js",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "prisma": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "@nestjs/core@10.4.22": true,
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "bcrypt@5.1.1": true
  }
}
